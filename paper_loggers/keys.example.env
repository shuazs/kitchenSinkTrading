# Keys for the paper loggers. Copy this file to paper_loggers/keys.env and fill
# in the blanks; keys.env is gitignored, so it never reaches GitHub. Every
# logger loads it on start (variables already set in your shell win).
#
# Nothing here can place an order: the loggers only read market data.
# Kalshi, Polymarket and Yahoo market data need no key.

# --- Required ---------------------------------------------------------------

# SEC EDGAR asks every client to identify itself: "Your Name your@email.com".
# Used by odd_lot_tenders.py and cef_rights_short.py.
SEC_USER_AGENT=

# --- Optional ---------------------------------------------------------------

# Where logs go (default ~/.cache/kitchensink; loggers write under paper/).
KS_CACHE_DIR=

# Only for the retired loggers in retired/ (kept for reference, not run):
# Alpaca paper-account keys (borrow check in retired/wsb_spikes.py).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Reddit script-app credentials (retired/wsb_spikes.py; it falls back to the public feed).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
